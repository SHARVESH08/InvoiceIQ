# InvoiceIQ — Environment Variables Example
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (.env*.local in .gitignore) — NEVER commit real credentials.

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Phase 5 — Server-only secrets
# Server-only — never use NEXT_PUBLIC_ prefix. .env.local must remain gitignored.
# These vars are accessed only in Next.js Route Handlers and Server Actions
# (never in client components). Using NEXT_PUBLIC_ would expose them to the browser.
# =============================================================================

# Razorpay (payment links — PAYMENT-01)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Resend (transactional email — EMAIL-01)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# WhatsApp / Meta webhook signature verification (SEC-04)
# Provided by Meta in App Dashboard → WhatsApp → Configuration → App Secret
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Phase 11 — AI Chatbot + Summaries + Pricing Alerts
# All four vars are REQUIRED for Phase 11 features. Missing any will cause the
# corresponding cron handler to return 401/500 with a descriptive error message.
# =============================================================================

# Groq (AI chatbot + nightly summaries — AI-01, AI-02, AI-03)
# Source: console.groq.com → API Keys → Create new key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search API (weekly market pricing alerts — PRICING-01, PRICING-02, PRICING-03)
# Source: api-dashboard.search.brave.com → API → Subscriptions → Free plan → Copy API key
BRAVE_SEARCH_API_KEY=BSA_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cron authentication secret (pg_cron → Next.js route handlers — EMAIL-02)
# Generate: openssl rand -hex 32
# Set in BOTH .env.local AND Vercel project env vars AND Supabase DB:
#   ALTER DATABASE postgres SET app.cron_secret = 'your-generated-secret';
CRON_SECRET=your-hex-32-secret-here

# Next.js deployment URL (pg_net needs this to call route handlers)
# Set in Supabase DB: ALTER DATABASE postgres SET app.next_url = 'https://YOUR_DOMAIN';
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
